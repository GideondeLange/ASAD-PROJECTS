# Serve clean URLs (no .html) and redirect old .html URLs to them.
# This keeps the actual files named *.html on disk — nothing else about
# the deploy changes — Apache just rewrites what the browser sees.

Options -MultiViews
RewriteEngine On

# 0. Canonical domain: force https and non-www. Google was indexing three
#    separate addresses (http://, https://www., http://www.) as if they
#    were different sites, splitting ranking signals three ways instead
#    of consolidating them onto one. asad.co.za (non-www, https) is the
#    chosen canonical - it matches the GA4 property and every canonical
#    tag already in the page templates.
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://asad.co.za/$1 [R=301,L]

# 0.5. Known dead pages still indexed by Google - redirect to the closest
#      live equivalent instead of leaving them 404, so any residual
#      ranking value carries over instead of leaking to a dead end.
RewriteRule ^contact-luxury-renovations/?$ /contact [R=301,L]

# 0.6. Bidwell -> ASAD rebrand: /bidwell was live and indexed under that
#      name; redirect it and its sub-pages to the new /asad-pods URLs so
#      the existing ranking signal transfers instead of 404ing.
RewriteRule ^bidwell/pod-1/?$ /asad-pods/pod-1 [R=301,L]
RewriteRule ^bidwell/pod-3/?$ /asad-pods/pod-3 [R=301,L]
RewriteRule ^bidwell/entertainment-pod/?$ /asad-pods/entertainment-pod [R=301,L]
RewriteRule ^bidwell/?$ /asad-pods [R=301,L]

# 1. External redirect: if a visitor or old bookmark hits *.html directly,
#    send them to the clean URL with a permanent (301) redirect so search
#    engines transfer ranking signals to the new URL instead of treating
#    it as duplicate content.
#    /index.html and /blog/index.html redirect to their directory root.
RewriteCond %{THE_REQUEST} \s/+((?:[^/\s]+/)*)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+((?:[^/\s]+/)*)([^/\s.]+)\.html[\s?] [NC]
RewriteRule ^ /%1%2 [R=301,L]

# 2. Internal rewrite: when a clean URL is requested, quietly serve the
#    matching .html file without changing what's shown in the address bar.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
