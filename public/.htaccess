# Serve clean URLs (no .html) and redirect old .html URLs to them.
# This keeps the actual files named *.html on disk — nothing else about
# the deploy changes — Apache just rewrites what the browser sees.

Options -MultiViews
# Always declare UTF-8 in the HTTP header so browsers never guess an old encoding
# (that garbled the non-breaking space in prices, m2, dashes and apostrophes).
AddDefaultCharset UTF-8

# Branded page for any address that does not exist (served with a real 404 status).
ErrorDocument 404 /404.html

RewriteEngine On

# 0. Canonical domain: force https and non-www. Google was indexing three
#    separate addresses (http://, https://www., http://www.) as if they
#    were different sites, splitting ranking signals three ways instead
#    of consolidating them onto one. asad.co.za (non-www, https) is the
#    chosen canonical - it matches the GA4 property and every canonical
#    tag already in the page templates.
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://asad.co.za/$1 [R=301,L]

# 0.3. PERMANENT QR CODE ADDRESS - DO NOT DELETE OR RENAME.
#       https://asad.co.za/qr is printed as a QR code on stickers, vehicles and
#       signs. Those cannot be reprinted, so this address must work forever.
#       It is a temporary (302) redirect on purpose: browsers never cache it,
#       so the destination below can be changed at any time without reprinting.
#       The utm tags let Google Analytics show how many visits came from QR scans.
RewriteRule ^qr/?$ /?utm_source=qr&utm_medium=sticker&utm_campaign=qr_sticker [NC,R=302,L]

# 0.5. Known dead pages still indexed by Google - redirect to the closest
#      live equivalent instead of leaving them 404, so any residual
#      ranking value carries over instead of leaking to a dead end.
RewriteRule ^contact-luxury-renovations/?$ /contact [R=301,L]
RewriteRule ^projects-asad-projects-blog-renovations-custom-glazed-steelwork-construction/?$ /gallery [R=301,L]
RewriteRule ^gallery-bespoke-steelwork/?$ /gallery [R=301,L]
RewriteRule ^transform-your-space-your-ultimate-guide-to-living-room-renovation/?$ /blog [R=301,L]
RewriteRule ^bidwell-pod-living-solutions-building-contractors/?$ /asad-pods [R=301,L]
RewriteRule ^bespoke-steelwork-custom-glazed-steelwork-contruction-and-renovation-pergolas-and-decking/?$ /services [R=301,L]

# 0.6. Bidwell -> ASAD rebrand: /bidwell was live and indexed under that
#      name; redirect it and its sub-pages to the new /asad-pods URLs so
#      the existing ranking signal transfers instead of 404ing.
RewriteRule ^bidwell/pod-1/?$ /asad-pods/pod-1 [R=301,L]
RewriteRule ^bidwell/pod-3/?$ /asad-pods/pod-3 [R=301,L]
RewriteRule ^bidwell/entertainment-pod/?$ /asad-pods/entertainment-pod [R=301,L]
RewriteRule ^bidwell/?$ /asad-pods [R=301,L]

# 0.65. Site rebuilt around the pods: the old Projects page is gone (its
#       work now lives in the Gallery) and Pod 3 is no longer in the range. Send them to the
#       closest live page so indexed URLs keep their ranking signal.
RewriteRule ^projects/?$ /gallery [R=301,L]
RewriteRule ^asad-pods/pod-3/?$ /asad-pods [R=301,L]

# 0.66. The 75 m2 2 Bedroom Living Unit was retired: send its page and its old
#       brochure link to the closest live pages.
RewriteRule ^asad-pods/2-bedroom-living-unit/?$ /asad-pods/2-bedroom [R=301,L]
RewriteRule ^asad-pods/3-bedroom/?$ /asad-pods/3-bedroom-pitched-house [R=301,L]
RewriteRule ^brochures/asad-2-bedroom-living-unit-75sqm-brochure.pdf$ /brochures [R=301,L]

# 0.7. /asad-pods also exists as a directory on disk (asad-pods/pod-1.html
#      etc.), so the generic rule below (which requires !-d) never fires
#      for it - Apache resolves "/asad-pods" straight to that directory,
#      finds no index file in it, and 403s instead of serving
#      asad-pods.html. Serve it explicitly before that generic rule runs.
RewriteRule ^asad-pods/?$ /asad-pods.html [L]

# 0.75. Same situation for /brochures: the PDFs live in a /brochures folder, so
#       serve the page explicitly. Browsers and Hostinger must always fetch the
#       latest PDF after one is overwritten under the same name, and the PDFs
#       open in the browser (not forced download).
RewriteRule ^brochures/?$ /brochures.html [L]
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Content-Disposition "inline"
  </FilesMatch>
</IfModule>

# 1. External redirect: if a visitor or old bookmark hits *.html directly,
#    send them to the clean URL with a permanent (301) redirect so search
#    engines transfer ranking signals to the new URL instead of treating
#    it as duplicate content.
#    /index.html and /blog/index.html redirect to their directory root.
RewriteCond %{THE_REQUEST} \s/+((?:[^/\s]+/)*)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+((?:[^/\s]+/)*)([^/\s.]+)\.html[\s?] [NC]
RewriteRule ^ /%1%2 [R=301,L]

# 2. Internal rewrite: when a clean URL is requested, quietly serve the
#    matching .html file without changing what's shown in the address bar.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
