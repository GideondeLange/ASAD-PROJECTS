# Serve clean URLs (no .html) and redirect old .html URLs to them.
# This keeps the actual files named *.html on disk — nothing else about
# the deploy changes — Apache just rewrites what the browser sees.

Options -MultiViews
RewriteEngine On

# 1. External redirect: if a visitor or old bookmark hits *.html directly,
#    send them to the clean URL with a permanent (301) redirect so search
#    engines transfer ranking signals to the new URL instead of treating
#    it as duplicate content.
#    /index.html and /blog/index.html redirect to their directory root.
RewriteCond %{THE_REQUEST} \s/+((?:[^/\s]+/)*)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+((?:[^/\s]+/)*)([^/\s.]+)\.html[\s?] [NC]
RewriteRule ^ /%1%2 [R=301,L]

# 2. Internal rewrite: when a clean URL is requested, quietly serve the
#    matching .html file without changing what's shown in the address bar.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
